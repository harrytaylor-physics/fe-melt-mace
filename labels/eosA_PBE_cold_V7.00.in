&CONTROL
  calculation = 'scf', prefix = 'eosA_PBE_cold_V7.00', outdir = './tmp_eosA/eosA_PBE_cold_V7.00',
  pseudo_dir = './pseudo', tstress = .true., tprnfor = .true., disk_io = 'nowf'
/
&SYSTEM
  ibrav = 4, celldm(1) = 4.0853067740, celldm(3) = 1.600000,
  nat = 2, ntyp = 1, ecutwfc = 100, ecutrho = 1000,
  occupations = 'smearing', smearing = 'mv', degauss = 0.01000000, nbnd = 32
/
&ELECTRONS
  conv_thr = 1.0d-10, mixing_beta = 0.3
/
ATOMIC_SPECIES
  Fe 55.845 Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Fe 0.3333333333 0.6666666667 0.25
  Fe 0.6666666667 0.3333333333 0.75
K_POINTS automatic
  20 20 13 0 0 0
