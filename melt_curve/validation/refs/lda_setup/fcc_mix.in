&CONTROL
  calculation = 'scf', prefix = 'fcc_mix', outdir = './tmp', pseudo_dir = './pseudo', tstress = .true., disk_io = 'none'
/
&SYSTEM
  ibrav = 2, celldm(1) = 5.7383215099,
  nat = 1, ntyp = 1, ecutwfc = 100, ecutrho = 1000,
  occupations = 'smearing', smearing = 'fd', degauss = 0.040085500769528125, nbnd = 16, input_dft = 'PZ'
/
&ELECTRONS
  conv_thr = 1.0d-8, mixing_beta = 0.3
/
ATOMIC_SPECIES
  Fe 55.845 Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Fe 0.0 0.0 0.0
K_POINTS automatic
  8 8 8 0 0 0
